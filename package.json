{
  "name": "letterboxd-api",
  "version": "2.0.0",
  "description": "Get public diary data for Letterboxd users with full TypeScript support",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "prettier": "prettier --write .",
    "lint": "eslint .",
    "example": "tsx test/example.ts",
    "pretest": "npm run prettier && npm run lint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "letterboxd",
    "typescript",
    "rss",
    "movies",
    "films",
    "diary"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zeromero-dev/letterboxd-api"
  },
  "author": "Roman <holubenko.job@gmail.com>",
  "license": "ISC",
  "dependencies": {
    "cheerio": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "nock": "^14.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
